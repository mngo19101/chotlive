# setup.sh thay __APP_DIR__ rồi chép vào /etc/systemd/system/chotlive.service.
[Unit]
Description=ChotLive server
After=network-online.target
Wants=network-online.target

[Service]
User=chotlive
Group=chotlive
WorkingDirectory=__APP_DIR__
EnvironmentFile=/etc/chotlive.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=DATA_DIR=/var/lib/chotlive
ExecStart=/usr/bin/env node --no-warnings server.js
Restart=always
RestartSec=3
# Đủ thời gian ghi nốt dữ liệu khi tắt.
TimeoutStopSec=20
LimitNOFILE=65535

# Server chỉ được ghi vào thư mục dữ liệu.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/chotlive
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
