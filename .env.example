PORT=3000
# Địa chỉ server lắng nghe. Trên VPS đặt 127.0.0.1 (deploy/chotlive.service đã đặt sẵn).
HOST=
# Mật khẩu admin, chỉ dùng khi tạo dữ liệu lần đầu (bỏ trống = tự sinh ngẫu nhiên và in ra log)
ADMIN_PASSWORD=
# Số ngày token đăng nhập còn hiệu lực
TOKEN_TTL_DAYS=30
# Thư mục lưu dữ liệu (trên VPS: /var/lib/chotlive, trên Render: /var/data)
DATA_DIR=
# API key Euler Stream, cần khi có nhiều live cùng lúc hoặc bị giới hạn lượt kết nối TikTok
SIGN_API_KEY=
# Đặt 1 khi server chạy trong cùng mạng với máy in (laptop, mini PC) để bật in LAN.
# TUYỆT ĐỐI không bật trên VPS.
LAN_MODE=
# Số lớp proxy phía trước server. Bỏ trống khi dùng Caddy cùng máy; trên Render đặt 1.
TRUST_PROXY=
