{
  "name": "chotlive",
  "version": "1.0.0",
  "description": "ChốtLive – đọc bình luận TikTok Live, bắt giá, in tem và chốt đơn (server và web)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "prestart": "node --no-warnings sync/sync.js before-start",
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test \"test/*.test.js\"",
    "backup:now": "node --env-file-if-exists=.env --no-warnings backup/cloud-backup.mjs run",
    "backup:status": "node --env-file-if-exists=.env --no-warnings backup/cloud-backup.mjs status",
    "backup:list": "node --env-file-if-exists=.env --no-warnings backup/cloud-backup.mjs list",
    "backup:test-restore": "node --env-file-if-exists=.env --no-warnings backup/cloud-backup.mjs test-restore",
    "backup:restore": "node --env-file-if-exists=.env --no-warnings backup/cloud-backup.mjs restore"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "express": "^5.3.0",
    "tiktok-live-connector": "^2.5.0",
    "ws": "^8.22.0"
  }
}
